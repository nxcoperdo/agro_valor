{
  "name": "agro-valor",
  "version": "0.1.0",
  "description": "Dashboard de café: precio en tiempo real, comparación de cooperativas y proyección de precios",
  "private": true,
  "keywords": [
    "cafe",
    "commodities",
    "dashboard"
  ],
  "license": "MIT",
  "author": "",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "nodemon server/index.js",
    "dev:frontend": "webpack serve --config webpack.config.dev.js",
    "build": "webpack --config webpack.config.prod.js",
    "start": "node server/index.js",
    "seed": "node server/db/seed.js",
    "set-password": "node server/db/setPassword.js",
    "fnc:scrape-and-push": "node scripts/fnc-scrape-and-push.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.4.4",
    "cheerio": "^1.0.0",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "copy-webpack-plugin": "^11.0.0",
    "html-webpack-plugin": "^5.6.0",
    "nodemon": "^3.1.4",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4",
    "webpack-merge": "^5.10.0"
  }
}
