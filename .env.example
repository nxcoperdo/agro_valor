PORT=3000
NODE_ENV=development

JWT_SECRET=reemplaza-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=8h
# Pon esto en "true" SOLO cuando el sitio ya tenga HTTPS (dominio + certificado). Con IP:puerto sin HTTPS, déjalo en false.
COOKIE_SECURE=false

ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

SQLITE_DB_PATH=./data/agro_valor.sqlite

# Opcionales: si faltan, el precio del café arranca directo en modo simulado.
TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=

COFFEE_BASE_PRICE_CENTS=380
EXCHANGE_RATE_FALLBACK_COP=4000
# Prima de los suaves colombianos sobre el contrato "C" de Nueva York, en dólares por libra.
# Solo se usa para la "paridad de exportación" (referencia teórica), nunca para el precio
# que se le muestra al caficultor como su precio de venta.
COLOMBIA_PREMIUM_USD_PER_LB=0.40
# Cada cuánto se consulta la cotización. Solo se guarda una fila nueva si el dato
# cambió, así que un intervalo corto no infla la base de datos.
PRICE_REFRESH_CRON=*/5 * * * *
FNC_REFERENCE_CRON=0 8,14 * * 1-5
FORECAST_REFRESH_CRON=0 15 * * *
COCOA_REFERENCE_URL=https://agronet.gov.co/noticias/precio-de-referencia-semanal-de-compra-de-cacao-fuente-industria-nacional-exportadores-0
COCOA_REFERENCE_CRON=0 9 * * *
FNC_SOURCE_URL=https://federaciondecafeteros.org/estadisticas-cafeteras/
# Opcional: solo se usa UNA vez, si al arrancar no hay ningún precio FNC guardado todavía
# (por ejemplo porque el scraping no logra conectarse desde tu servidor). Pon el precio
# interno de referencia de hoy en COP por carga de 125kg, consultándolo tú manualmente en
# federaciondecafeteros.org. En cuanto el scraping automático funcione, lo reemplaza solo.
FNC_FALLBACK_COP_CARGA=
# Token secreto compartido con el workflow de GitHub Actions (.github/workflows/fnc-price-sync.yml)
# que scrapea la FNC desde afuera del VPS (que tiene la IP bloqueada) y empuja el precio
# a POST /api/internal/fnc-price. Genera un valor largo y random, y ponlo también como
# secret "FNC_INGEST_TOKEN" en GitHub (junto con "VPS_BASE_URL" apuntando a este servidor).
FNC_INGEST_TOKEN=

# --- Alertas por WhatsApp (Meta WhatsApp Business Cloud API) ---
# https://developers.facebook.com/docs/whatsapp/cloud-api
# 1. Crea una app tipo "Business" en developers.facebook.com y agrégale el producto WhatsApp.
# 2. En el dashboard de WhatsApp del app te dan el Phone Number ID y un token temporal;
#    genera uno permanente (System User token) para producción.
# 3. Crea y somete a aprobación de Meta las 3 plantillas que usa el código (nombres exactos
#    abajo, o cambia el nombre acá si las llamaste distinto). Los mensajes de alerta los
#    inicia el servidor, no el usuario, así que Meta exige plantilla aprobada, no texto libre.
# Déjalo vacío para desactivar el envío (las alertas quedan registradas, no se envían).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANG=es
# Plantilla "el precio cruzó tu meta" — 4 variables: dirección, meta, precio de referencia, mejor precio.
WHATSAPP_TEMPLATE_ALERT=agrovalor_alerta_precio
# Plantilla del resumen diario/semanal — 5 variables: referencia, mejor precio, mañana, semana, mes.
WHATSAPP_TEMPLATE_DIGEST=agrovalor_resumen_mercado
# Plantilla de bienvenida/prueba al conectar el número — 2 variables: referencia, mejor precio.
WHATSAPP_TEMPLATE_WELCOME=agrovalor_bienvenida

# --- Notificaciones push a la app móvil (Firebase Cloud Messaging) ---
# 1. Crea un proyecto en console.firebase.google.com y agrégale una app Android con el
#    paquete co.agrovalor.app. Descarga google-services.json a mobile/android/app/.
# 2. En Configuración del proyecto → Cuentas de servicio → "Generar nueva clave privada".
#    Sube ese JSON al VPS (fuera del repo) y pon aquí su ruta.
# Déjalo vacío para desactivar push (las alertas siguen saliendo por WhatsApp).
FIREBASE_SERVICE_ACCOUNT_PATH=

DAILY_DIGEST_CRON=0 6 * * *
WEEKLY_DIGEST_CRON=0 6 * * 1

# Pon "false" si quieres que solo tú puedas crear cuentas (sin registro abierto al público).
ALLOW_PUBLIC_SIGNUP=true

# --- Cobro de Pro por Mercado Pago Checkout Pro (pago único anual, web y app) ---
# developers.mercadopago.com.co → Tus integraciones → tu app → Credenciales.
# Usa primero las de PRUEBA (empiezan con TEST-) para probar el flujo completo con
# tarjetas de prueba antes de poner las de producción.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# Tus integraciones → Webhooks → Configurar notificación → revelar clave.
MP_WEBHOOK_SECRET=
MP_PRO_ANNUAL_AMOUNT_COP=150000
# A dónde redirige Mercado Pago cuando el usuario termina de pagar (web y navegador externo de la app).
MP_BACK_URL=https://agrovalor.tech/#/cuenta
# Respaldo del webhook: cada cuánto se revisa si un pago que quedó "pending" ya se aprobó.
MP_POLL_CRON=0 8 * * *

# --- Datos legales publicados en Privacidad, Términos y la página DMCA (#/dmca) ---
# Pon aquí tus datos reales; mientras estén vacíos, las páginas muestran "pendiente".
LEGAL_CONTACT_EMAIL=
LEGAL_POSTAL_ADDRESS=
# Agente designado DMCA (el mismo que registres en https://dmca.copyright.gov/).
DMCA_AGENT_NAME=
DMCA_AGENT_EMAIL=
DMCA_AGENT_PHONE=
