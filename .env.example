PORT=3000
NODE_ENV=development

JWT_SECRET=reemplaza-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=8h
# Pon esto en "true" SOLO cuando el sitio ya tenga HTTPS (dominio + certificado). Con IP:puerto sin HTTPS, déjalo en false.
COOKIE_SECURE=false

ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

SQLITE_DB_PATH=./data/agro_valor.sqlite

# Opcionales: si faltan, el precio del café arranca directo en modo simulado.
TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=

COFFEE_BASE_PRICE_CENTS=380
EXCHANGE_RATE_FALLBACK_COP=4000
# Prima de los suaves colombianos sobre el contrato "C" de Nueva York, en dólares por libra.
# Solo se usa para la "paridad de exportación" (referencia teórica), nunca para el precio
# que se le muestra al caficultor como su precio de venta.
COLOMBIA_PREMIUM_USD_PER_LB=0.40
# Cada cuánto se consulta la cotización. Solo se guarda una fila nueva si el dato
# cambió, así que un intervalo corto no infla la base de datos.
PRICE_REFRESH_CRON=*/5 * * * *
FNC_REFERENCE_CRON=0 8,14 * * 1-5
FORECAST_REFRESH_CRON=0 15 * * *
FNC_SOURCE_URL=https://federaciondecafeteros.org/estadisticas-cafeteras/
# Opcional: solo se usa UNA vez, si al arrancar no hay ningún precio FNC guardado todavía
# (por ejemplo porque el scraping no logra conectarse desde tu servidor). Pon el precio
# interno de referencia de hoy en COP por carga de 125kg, consultándolo tú manualmente en
# federaciondecafeteros.org. En cuanto el scraping automático funcione, lo reemplaza solo.
FNC_FALLBACK_COP_CARGA=
# Token secreto compartido con el workflow de GitHub Actions (.github/workflows/fnc-price-sync.yml)
# que scrapea la FNC desde afuera del VPS (que tiene la IP bloqueada) y empuja el precio
# a POST /api/internal/fnc-price. Genera un valor largo y random, y ponlo también como
# secret "FNC_INGEST_TOKEN" en GitHub (junto con "VPS_BASE_URL" apuntando a este servidor).
FNC_INGEST_TOKEN=

# --- Alertas por WhatsApp ---
# AgroValor no habla con WhatsApp directamente: le hace un POST al proyecto de envío
# masivo que ya corre en este mismo servidor (así una sola sesión sirve para ambos).
# El endpoint debe aceptar:  POST { "to": "573001234567", "message": "texto" }
# Déjalo vacío para desactivar el envío (las alertas quedan registradas, no se envían).
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

DAILY_DIGEST_CRON=0 6 * * *
WEEKLY_DIGEST_CRON=0 6 * * 1

# Pon "false" si quieres que solo tú puedas crear cuentas (sin registro abierto al público).
ALLOW_PUBLIC_SIGNUP=true
