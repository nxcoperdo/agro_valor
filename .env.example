PORT=3000
NODE_ENV=development

JWT_SECRET=reemplaza-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=8h
# Pon esto en "true" SOLO cuando el sitio ya tenga HTTPS (dominio + certificado). Con IP:puerto sin HTTPS, déjalo en false.
COOKIE_SECURE=false

ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

SQLITE_DB_PATH=./data/agro_valor.sqlite

# Opcionales: si faltan, el precio del café arranca directo en modo simulado.
TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=

COFFEE_BASE_PRICE_CENTS=380
EXCHANGE_RATE_FALLBACK_COP=4000
PRICE_REFRESH_CRON=*/30 * * * *
FNC_REFERENCE_CRON=0 8,14 * * 1-5
FORECAST_REFRESH_CRON=0 15 * * *
FNC_SOURCE_URL=https://federaciondecafeteros.org/estadisticas-cafeteras/
# Opcional: solo se usa UNA vez, si al arrancar no hay ningún precio FNC guardado todavía
# (por ejemplo porque el scraping no logra conectarse desde tu servidor). Pon el precio
# interno de referencia de hoy en COP por carga de 125kg, consultándolo tú manualmente en
# federaciondecafeteros.org. En cuanto el scraping automático funcione, lo reemplaza solo.
FNC_FALLBACK_COP_CARGA=
